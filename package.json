{
  "name": "lgsb2mqtt",
  "version": "2.1.1",
  "description": "Interface between LG soundbars and MQTT",
  "type": "module",
  "main": "index.js",
  "bin": {
    "lgsb2mqtt": "index.js"
  },
  "preferGlobal": true,
  "files": [
    "index.js",
    "config.js",
    "lib/"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "deploy": "bash deploy.sh"
  },
  "keywords": [
    "lg",
    "soundbar",
    "mqtt",
    "smarthome",
    "mqtt-smarthome",
    "home-automation",
    "home-assistant"
  ],
  "author": "Sebastian 'Hobbyquaker' Raff <hobbyquaker@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/lgsb2mqtt.git"
  },
  "bugs": {
    "url": "https://github.com/hobbyquaker/lgsb2mqtt/issues"
  },
  "homepage": "https://github.com/hobbyquaker/lgsb2mqtt#readme",
  "mqttInterfaces": {
    "spec": "2.0",
    "envPrefix": "LGSB2MQTT",
    "needs": [
      "network"
    ],
    "serviceExtra": []
  },
  "dependencies": {
    "mqtt-interfaces-core": "^0.15.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
